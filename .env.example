# Configuración de infraestructura de monitorr (env vars MONITORR_*).
# La configuración de la app (Sonarr, parámetros de ventana, grace, overrides) NO va aquí:
# vive en SQLite y se edita desde la Web UI. Copia este archivo a `.env` y ajústalo.

# Directorio de datos (SQLite + identidad de cliente Plex). En Docker se monta como volumen.
MONITORR_CONFIG_DIR=/config

# Puerto de escucha de la Web UI / API.
MONITORR_PORT=8080

# Nivel de log: DEBUG | INFO | WARNING | ERROR.
MONITORR_LOG_LEVEL=INFO

# Intervalo (segundos) de sondeo de sesiones de Plex (detección de visionado).
MONITORR_PLEX_POLL_INTERVAL=30

# Intervalo (segundos) del barrido de grace periods (borrados diferidos).
MONITORR_GRACE_SWEEP_INTERVAL=3600

# Intervalo (segundos) de la sincronización/reconciliación periódica. 0 lo desactiva.
MONITORR_SYNC_INTERVAL=21600

# Sincronizar una vez al arrancar si nunca se hizo antes.
MONITORR_SYNC_ON_STARTUP=true

# Token opcional para proteger el webhook de Plex (recomendado si lo expones).
MONITORR_WEBHOOK_SECRET=

# Zona horaria (afecta al cálculo de grace periods).
TZ=UTC
