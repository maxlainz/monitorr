# monitorr infrastructure configuration (MONITORR_* env vars).
# The app configuration (Sonarr, window parameters, grace, overrides) does NOT go here:
# it lives in SQLite and is edited from the Web UI. Copy this file to `.env` and adjust it.

# Data directory (SQLite + Plex client identity). In Docker it's mounted as a volume.
MONITORR_CONFIG_DIR=/config

# Listening port for the Web UI / API.
MONITORR_PORT=8080

# Log level: DEBUG | INFO | WARNING | ERROR.
MONITORR_LOG_LEVEL=INFO

# Interval (seconds) for polling Plex sessions (viewing detection).
MONITORR_PLEX_POLL_INTERVAL=30

# Interval (seconds) for the grace-period sweep (deferred deletions).
MONITORR_GRACE_SWEEP_INTERVAL=3600

# Interval (seconds) for the periodic sync/reconciliation. 0 disables it.
MONITORR_SYNC_INTERVAL=21600

# Sync once on startup if it never ran before.
MONITORR_SYNC_ON_STARTUP=true

# Optional override for the Plex webhook secret. Leave empty: monitorr auto-generates one and
# shows the ready-to-use webhook URL in Settings. Set it only to pin the same secret across
# instances or restarts.
MONITORR_WEBHOOK_SECRET=

# Time zone (affects the grace-period calculation).
TZ=UTC
